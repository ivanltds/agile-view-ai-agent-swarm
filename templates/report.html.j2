<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Efficiency Report — {{ meta.project }} / {{ meta.team }}</title>
<style>
  :root { --bg:#0f172a; --card:#1e293b; --ink:#e2e8f0; --muted:#94a3b8;
          --accent:#6366f1; --good:#22c55e; --warn:#f59e0b; --bad:#ef4444; }
  * { box-sizing:border-box; }
  body { margin:0; font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;
         background:var(--bg); color:var(--ink); line-height:1.5; }
  header { padding:2rem 1.5rem; border-bottom:1px solid #334155; }
  header h1 { margin:0 0 .25rem; font-size:1.5rem; }
  header .sub { color:var(--muted); font-size:.9rem; }
  main { max-width:1100px; margin:0 auto; padding:1.5rem; }
  section { background:var(--card); border:1px solid #334155; border-radius:12px;
            padding:1.25rem 1.5rem; margin-bottom:1.5rem; }
  section h2 { margin-top:0; font-size:1.15rem; }
  .kpis { display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:1rem; }
  .kpi { background:#0b1220; border-radius:10px; padding:1rem; text-align:center; }
  .kpi .val { font-size:1.6rem; font-weight:700; }
  .kpi .label { color:var(--muted); font-size:.8rem; text-transform:uppercase; letter-spacing:.04em; }
  table { width:100%; border-collapse:collapse; font-size:.9rem; }
  th,td { text-align:left; padding:.5rem .6rem; border-bottom:1px solid #334155; }
  th { color:var(--muted); font-weight:600; }
  .pill { display:inline-block; padding:.1rem .5rem; border-radius:999px; font-size:.75rem; }
  .pill.warn { background:rgba(245,158,11,.15); color:var(--warn); }
  .pill.bad { background:rgba(239,68,68,.15); color:var(--bad); }
  .grid2 { display:grid; grid-template-columns:repeat(auto-fit,minmax(320px,1fr)); gap:1.5rem; }
  .trend.improving { color:var(--good); } .trend.declining { color:var(--bad); }
  .trend.stable { color:var(--muted); }
  .narrative { color:var(--muted); }
  .unavailable { color:var(--warn); font-style:italic; }
  canvas { max-height:300px; }
  ul li { margin:.25rem 0; }
  footer { text-align:center; color:var(--muted); font-size:.8rem; padding:2rem; }
</style>
</head>
<body>
<header>
  <h1>{{ meta.project }} — {{ meta.team }}</h1>
  <div class="sub">
    Organization {{ meta.org }} · Generated {{ meta.generated_at.strftime('%Y-%m-%d %H:%M') }} ·
    {{ meta.sprints_analyzed }} sprints · {{ meta.items_in_range }} work items
  </div>
</header>
<main>

  <section>
    <h2>Executive summary</h2>
    <div class="kpis">
      <div class="kpi"><div class="val">{{ metrics.lead_time_avg_days }}d</div><div class="label">Lead Time (avg)</div></div>
      <div class="kpi"><div class="val">{{ metrics.cycle_time_avg_days }}d</div><div class="label">Cycle Time (avg)</div></div>
      <div class="kpi"><div class="val">{{ metrics.throughput_avg }}</div><div class="label">Throughput / sprint</div></div>
      <div class="kpi"><div class="val">{{ metrics.bug_rate_pct }}%</div><div class="label">Bug Rate</div></div>
      <div class="kpi"><div class="val">{{ metrics.reopen_rate_pct }}%</div><div class="label">Reopen Rate</div></div>
      <div class="kpi"><div class="val">{{ metrics.unestimated_pct }}%</div><div class="label">Unestimated</div></div>
    </div>
    {% if metrics.narrative %}<p class="narrative" style="margin-top:1rem">{{ metrics.narrative }}</p>{% endif %}
  </section>

  <div class="grid2">
    <section>
      <h2>Velocity <span class="trend {{ sprint.velocity_trend }}">({{ sprint.velocity_trend }})</span></h2>
      {% if velocity_data.labels %}<canvas id="velocity"></canvas>
      {% else %}<p class="unavailable">No velocity data available.</p>{% endif %}
      {% if sprint.insights %}<p class="narrative">{{ sprint.insights }}</p>{% endif %}
    </section>
    <section>
      <h2>Current sprint burndown</h2>
      {% if burndown_data.labels %}<canvas id="burndown"></canvas>
      {% else %}<p class="unavailable">No burndown data available.</p>{% endif %}
    </section>
  </div>

  <div class="grid2">
    <section>
      <h2>By type</h2>
      <table><thead><tr><th>Type</th><th>Count</th></tr></thead><tbody>
      {% for t, c in type_counts.items() %}<tr><td>{{ t }}</td><td>{{ c }}</td></tr>{% endfor %}
      </tbody></table>
    </section>
    <section>
      <h2>By state</h2>
      <table><thead><tr><th>State</th><th>Count</th></tr></thead><tbody>
      {% for s, c in state_counts.items() %}<tr><td>{{ s }}</td><td>{{ c }}</td></tr>{% endfor %}
      </tbody></table>
    </section>
  </div>

  <section>
    <h2>Team breakdown</h2>
    <table><thead><tr><th>Member</th><th>Items</th><th>Story points</th></tr></thead><tbody>
    {% for m in team_breakdown %}<tr><td>{{ m.name }}</td><td>{{ m.items }}</td><td>{{ m.points }}</td></tr>{% endfor %}
    </tbody></table>
  </section>

  <section>
    <h2>At-risk items ({{ at_risk|length }})</h2>
    {% if at_risk %}
    <table><thead><tr><th>ID</th><th>Title</th><th>Type</th><th>Reason</th></tr></thead><tbody>
    {% for r in at_risk %}<tr><td>{{ r.id }}</td><td>{{ r.title }}</td><td>{{ r.type }}</td>
      <td><span class="pill {{ 'bad' if 'Blocked' in r.reasons else 'warn' }}">{{ r.reasons }}</span></td></tr>{% endfor %}
    </tbody></table>
    {% else %}<p class="narrative">No at-risk items detected.</p>{% endif %}
  </section>

  <section>
    <h2>Recommendations</h2>
    {{ recommendations | safe }}
  </section>

  {% if unavailable_sections %}
  <section><p class="unavailable">Some sections could not be generated: {{ unavailable_sections|join(', ') }}.</p></section>
  {% endif %}

</main>
<footer>Generated by Azure Boards Agent Swarm</footer>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
<script>
const velocityData = {{ velocity_data | tojson }};
const burndownData = {{ burndown_data | tojson }};
function ready(){ return typeof Chart !== 'undefined'; }
window.addEventListener('load', function(){
  if(!ready()){
    document.querySelectorAll('canvas').forEach(function(c){
      const p=document.createElement('p'); p.className='unavailable';
      p.textContent='Chart.js could not be loaded (offline). See CONTRIBUTING.md to bundle it.';
      c.replaceWith(p);
    });
    return;
  }
  const palette=['#6366f1','#22c55e','#f59e0b','#ef4444'];
  function colorize(d){ d.datasets.forEach((s,i)=>{ s.borderColor=palette[i%4]; s.backgroundColor=palette[i%4]+'55'; }); return d; }
  if(velocityData.labels.length){
    new Chart(document.getElementById('velocity'),{type:'bar',data:colorize(velocityData),
      options:{responsive:true,plugins:{legend:{labels:{color:'#e2e8f0'}}},
      scales:{x:{ticks:{color:'#94a3b8'}},y:{ticks:{color:'#94a3b8'}}}}});
  }
  if(burndownData.labels.length){
    new Chart(document.getElementById('burndown'),{type:'line',data:colorize(burndownData),
      options:{responsive:true,plugins:{legend:{labels:{color:'#e2e8f0'}}},
      scales:{x:{ticks:{color:'#94a3b8'}},y:{ticks:{color:'#94a3b8'}}}}});
  }
});
</script>
</body>
</html>
