# Azure Boards Agent Swarm — environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Azure DevOps ─────────────────────────────────────────────────────────────
AZURE_ORG=your-organization-name
AZURE_PAT=your-personal-access-token-here

# Optional: set here or pass as CLI flags
# AZURE_PROJECT=MyProject
# AZURE_TEAM=TeamAlpha

# ── Swarm behavior ───────────────────────────────────────────────────────────
SWARM_SPRINTS=5
SWARM_OUTPUT_DIR=./reports
SWARM_VERBOSE=false
SWARM_BATCH_SIZE=50
